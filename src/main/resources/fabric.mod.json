{
  "schemaVersion": 1,
  "id": "anchiale",
  "version": "${version}",
  "name": "Anchiale",
  "description": "Adds a faster way to exit worlds. Use the Quit to Title button to exit the current world without waiting for the server tasks queue to complete.",
  "authors": [
    "RedLime",
    "voidxwalker",
    "Gregor",
    "pixfumy",
    "KingContaria",
    "tildejustin"
  ],
  "contact": {
    "homepage": "https://github.com/Minecraft-Java-Edition-Speedrunning/anchiale",
    "sources": "https://github.com/Minecraft-Java-Edition-Speedrunning/anchiale",
    "issues": "https://github.com/Minecraft-Java-Edition-Speedrunning/anchiale/issues"
  },
  "icon": "assets/anchiale/icon.png",
  "license": "MIT",
  "environment": "*",
  "custom": {
    "speedrunapi": {
      "config": "me.voidxwalker.anchiale.AnchialeConfig"
    }
  },
  "mixins": [
    "anchiale.mixins.json"
  ],
  "depends": {
    "minecraft": ">1.7.10 <1.13",
    "fabricloader": ">=0.15"
  }
}